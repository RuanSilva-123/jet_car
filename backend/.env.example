APP_NAME=JetCar
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_HOST, DB_DATABASE, DB_USERNAME e DB_PASSWORD são injetados pelo
# docker-compose a partir do .env da raiz do projeto.
DB_CONNECTION=pgsql

# Sessão do painel (cookie HttpOnly) guardada no Redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# Em produção (HTTPS) defina como true
SESSION_SECURE_COOKIE=false

# Domínios (host:porta) do frontend que usam autenticação por cookie (Sanctum SPA)
SANCTUM_STATEFUL_DOMAINS=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@jetcar.local"
MAIL_FROM_NAME="${APP_NAME}"

# Usuário "master" criado pelo seeder (MasterUserSeeder).
# É o único que nasce no sistema; os demais usuários são criados por ele no painel.
MASTER_NAME="Administrador Master"
MASTER_EMAIL=
MASTER_PASSWORD=

# Catálogo de veículos FIPE (opcional). Sem token: 500 consultas/dia; com token gratuito: 1000/dia.
# https://fipe.online
FIPE_TOKEN=

# Preenchimento automático do veículo pela placa (opcional).
# "apibrasil": plano gratuito com 100 consultas/dia — crie a conta em https://apibrasil.com.br,
#   gere um dispositivo do serviço de Veículos e copie o Bearer Token e o Device Token.
# "apiplacas": https://apiplacas.com.br (10 consultas grátis no cadastro, depois pago).
# Sem tokens, o painel funciona normalmente, só sem o preenchimento pela placa.
PLATE_LOOKUP_DRIVER=apibrasil
APIBRASIL_BEARER_TOKEN=
APIBRASIL_DEVICE_TOKEN=
APIPLACAS_TOKEN=

# Fuso dos textos gerados pelo servidor (agenda, relatórios, "hoje" do dashboard). O banco fica em UTC.
DISPLAY_TIMEZONE=America/Sao_Paulo

# Lembretes de revisão: o cliente entra na lista de contato com esta antecedência
# (o comando jetcar:service-reminders roda todo dia às 6h no container scheduler).
REMINDER_LEAD_DAYS=15
REMINDER_LEAD_KM=500
