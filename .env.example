# Variáveis do Docker Compose (copie para .env)

# Porta do painel no host
APP_PORT=80

# Banco de dados (usado pelo container postgres e injetado no Laravel)
DB_DATABASE=jetcar
DB_USERNAME=jetcar
DB_PASSWORD=change-me

# Porta do Postgres exposta no host (apenas dev, para clientes como DBeaver)
DB_FORWARD_PORT=5433

# Interface do Mailpit (apenas dev)
MAILPIT_PORT=8025

# Adminer — interface web do banco (apenas dev)
ADMINER_PORT=8081

# Backup diário (container backup): horário, fuso e quantos dias guardar
BACKUP_TIME=03:00
BACKUP_TZ=America/Sao_Paulo
BACKUP_KEEP_DAYS=14
